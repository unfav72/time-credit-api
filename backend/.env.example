# ==============================================================================
# TIMECREDIT LIVE — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All sensitive secrets must be configured directly within your hosting provider's
# secret manager (e.g. Render Environment Variables, Railway Variables, or Supabase).
# NEVER commit populated values or live production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# Service Owner: TimeCredit PHP API Runtime
# ------------------------------------------------------------------------------
APP_ENV=production                       # Options: 'development' | 'production'
APP_DEBUG=false                          # Set to 'false' in production to disable raw stack traces
APP_NAME="TimeCredit Live"
APP_URL=https://api.timecredit.live      # Canonical HTTPS URL of your deployed PHP API
FRONTEND_URL=https://frontend-five-jade-83.vercel.app # Exact origin allowed for credentialed CORS

# ------------------------------------------------------------------------------
# 2. MANAGED POSTGRESQL DATABASE (Primary Production Datastore)
# Service Owner: Managed PostgreSQL (e.g. Supabase, Neon Serverless, AWS RDS)
# Note: You may either provide a single connection URL (DATABASE_URL) OR discrete parameters.
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:5432/[YOUR_DB_NAME]?sslmode=require

# Discrete Database Parameters (Used if DATABASE_URL is not set):
DB_CONNECTION=pgsql                      # 'pgsql' for PostgreSQL (Required)
DB_HOST=db.example-supabase.co           # Hostname of managed PostgreSQL instance
DB_PORT=5432                             # Default PostgreSQL TLS port
DB_DATABASE=postgres                     # Production database name
DB_USERNAME=postgres                     # Restricted production database user
DB_PASSWORD=[YOUR_RESTRICTED_DB_PASSWORD] # Strong, non-root database password
DB_SSLMODE=require                       # Enforce TLS encryption for cloud database connections

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# Service Owner: TimeCredit PHP API
# ------------------------------------------------------------------------------
# 64-character cryptographically secure random key used for HMAC-SHA256 Bearer tokens & sessions
# Generate via: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=[YOUR_64_CHAR_HEX_RANDOM_SESSION_SECRET]

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY INTEGRATION
# Service Owner: Razorpay Dashboard (https://dashboard.razorpay.com)
# WARNING: NEVER expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend!
# ------------------------------------------------------------------------------
RAZORPAY_MODE=test                       # Options: 'test' | 'live'
RAZORPAY_KEY_ID=rzp_test_[YOUR_TEST_KEY_ID]
RAZORPAY_KEY_SECRET=[YOUR_TEST_KEY_SECRET]
RAZORPAY_WEBHOOK_SECRET=[YOUR_CONFIGURED_WEBHOOK_SECRET]

# ------------------------------------------------------------------------------
# 5. WEB PUSH NOTIFICATIONS (VAPID Cryptographic Keys)
# Service Owner: Web Push Delivery Service
# Generate VAPID keypair via: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=[YOUR_PUBLIC_VAPID_KEY_BASE64]
VAPID_PRIVATE_KEY=[YOUR_PRIVATE_VAPID_KEY_BASE64]
VAPID_SUBJECT="mailto:admin@timecredit.live"

# ------------------------------------------------------------------------------
# 6. VIDEO CONFERENCING & REAL-TIME COLLABORATION
# Service Owner: Jitsi Meet / 8x8 Video Engine
# ------------------------------------------------------------------------------
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=""                          # Leave empty for free public tier, or populate if using 8x8 JaaS

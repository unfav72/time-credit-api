# ==============================================================================
# TIMECREDIT LIVE — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Vite applications, all variables prefixed with VITE_ are bundled into public
# client-side JavaScript. 
#
# CRITICAL SECURITY RULE:
# NEVER place private secrets (such as database passwords, Razorpay Key Secret, 
# Webhook Secret, or VAPID Private Key) in this file or any frontend configuration!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PHP REST API BASE URL
# Service Owner: TimeCredit PHP API Deployment (e.g. Render, Railway, Fly.io)
# ------------------------------------------------------------------------------
# In local development: http://localhost:8000/api
# In production on Vercel: Set this in the Vercel Project Dashboard -> Settings -> Environment Variables
VITE_API_URL=https://api.timecredit.live/api

# ------------------------------------------------------------------------------
# 2. RAZORPAY PUBLIC KEY ID
# Service Owner: Razorpay Dashboard (https://dashboard.razorpay.com)
# ------------------------------------------------------------------------------
# Public client Key ID used by Razorpay Checkout.js modal in the browser.
# DO NOT put the Razorpay Key Secret here!
VITE_RAZORPAY_KEY_ID=rzp_test_TrFi6LyCzcSU8k

# ------------------------------------------------------------------------------
# 3. WEB PUSH NOTIFICATIONS (Public VAPID Key)
# Service Owner: Browser Web Push / Service Worker
# ------------------------------------------------------------------------------
# Public application server key required by browser PushManager.subscribe()
# DO NOT put the private VAPID key here!
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U

# ------------------------------------------------------------------------------
# 4. VIDEO CONFERENCING PUBLIC DOMAIN
# Service Owner: Jitsi Meet Public Domain
# ------------------------------------------------------------------------------
VITE_JITSI_DOMAIN=meet.jit.si
